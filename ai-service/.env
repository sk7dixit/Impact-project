# AI Service Environment Configuration

# Server Settings
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_NAME=AI Exam Assistant Service
DEBUG=true

# PostgreSQL + pgvector Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/exam_assistant_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/exam_assistant_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Vector Settings
VECTOR_DIMENSION=768
VECTOR_INDEX_TYPE=ivfflat
VECTOR_INDEX_LISTS=100
SIMILARITY_METRIC=cosine
SIMILARITY_TOP_K=5

# LLM / AI Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQUENCE_LENGTH=512

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNKING_STRATEGY=recursive

# PDF Processing
MAX_PDF_SIZE_MB=50
SUPPORTED_EXTENSIONS=.pdf,.PDF

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD_SECONDS=60

# Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_FILE_SIZE_MB=50

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/ai_service.log

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5000"]

# Cache
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
